{
  "permissions": {
    "allow": [
      "Bash(bash factory/standards/*.sh:*)",
      "Bash(bash plugin/scripts/validate-backlog.sh:*)",
      "Bash(bash plugin/scripts/validate-memory.sh:*)",
      "Bash(git check-ignore:*)",
      "Bash(awk *)",
      "Bash(shasum *)",
      "mcp__scheduled-tasks__list_scheduled_tasks",
      "mcp__Claude_Browser__find",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__tabs_context_mcp"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh repo delete:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/decision-log-reminder.sh\"",
            "timeout": 10,
            "statusMessage": "Decision log · reminder"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugin/scripts/backup-pandacorp-state.sh\" \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 30,
            "statusMessage": "Pandacorp state backup",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugin/scripts/vault-overlay-sync.sh\" \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 30,
            "statusMessage": "Pandacorp vault · overlay sync"
          }
        ]
      }
    ]
  }
}
