# Obsidian workspace noise
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/*/data.json
.obsidian/cache
.trash/

# State caches
.pandacorp-cache/
# Factory-root runtime state — LIVE machinery, not stale (audit-20): DR-099's per-session
# touched-file records (.pandacorp/run/sessions/) and worktree manifests (.pandacorp/run/worktrees/)
# actively live here. The factory has no .pandacorp/ OVERLAY (no status.yaml — it is not a product
# project; the DR-062 marker still discriminates), but its runtime dir is real. Never committed.
.pandacorp/
# Framework templates are versioned machinery, never owner state.
!plugin/templates/shared/.pandacorp/
!plugin/templates/shared/.pandacorp/session-cleanup.sh

# Node / build artefacts (no package.json at root — any node_modules here is accidental)
node_modules/

# Owner's personal data (NOT published). The versioned seeds are
# factory/profile.example.md and factory/portfolio.example.md; /pandacorp:onboarding
# generates the real versions below. The idea cards are personal too.
factory/profile.md
factory/portfolio.md
# Persistent URL identities are owner data; the lifecycle CLI is their only writer.
factory/navigation-identities.json
factory/navigation-identities.json.lock
factory/navigation-identities.json.*.tmp
factory/ports.yaml
factory/ideas/*.md
!factory/ideas/_idea-template.md
!factory/ideas/decision-log.md
factory/ideas/_drafts/**
!factory/ideas/_drafts/README.md

# Nested Mission Control overlay: reopen this directory, then expose ONLY managed source files.
# Inventory: plugin/docs/nested-projects.md; staging: plugin/scripts/stage-managed-overlay.mjs.
# Unknown additions, run/, comms/, inbox/, accounts/, identities, caches and hooks stay private.
!/mission-control/.pandacorp/
/mission-control/.pandacorp/*
!/mission-control/.pandacorp/README.md
!/mission-control/.pandacorp/guide.md
!/mission-control/.pandacorp/status.yaml
!/mission-control/.pandacorp/idea-origin.md
!/mission-control/.pandacorp/track.jsonl
!/mission-control/.pandacorp/build-journal.jsonl
!/mission-control/.pandacorp/verify.sh
!/mission-control/.pandacorp/vitest-policy.ts
!/mission-control/.pandacorp/gate-budget.json
!/mission-control/.pandacorp/canary.sh
!/mission-control/.pandacorp/merge-queue.sh
!/mission-control/.pandacorp/green-stamp.sh
!/mission-control/.pandacorp/change-reconcile.mjs
!/mission-control/.pandacorp/session-cleanup.sh
!/mission-control/.pandacorp/worktree-bootstrap.sh
!/mission-control/.pandacorp/pending-work.sh
!/mission-control/.pandacorp/serve-once.sh
!/mission-control/.pandacorp/doc-lint.sh
!/mission-control/.pandacorp/check-project-skills.mjs
!/mission-control/.pandacorp/risk-paths
# File exceptions must never reopen directories bearing the same names.
/mission-control/.pandacorp/*/

# Factory self-learning raw capture inbox (provisional notes; the librarian refines them into committed factory/memory/LESSON-*.md)
factory/memory/_inbox.md
# Sweep marker written by the scheduled memory routine (machine-local state, loop v2)
factory/memory/_last-sweep

# Gamification ledger — personal data (DR-033, AC-09-006.3). Records the historical
# maximum guild outcomes so deleting a project never decreases XP/level (WO-09-006).
factory/gamification-ledger.json

# OS
.DS_Store

# Claude Code local (any level: root, mission-control/, projects…)
.claude/settings.local.json
.claude/launch.json
**/.claude/settings.local.json
**/.claude/launch.json

# Owner-facing Spanish pitches/memos (HTML) — gitignored per the committed=English rule
docs/proposals/*.html
factory/ideas/*.html

# Playwright MCP browser-tool logs (local tooling output)
.playwright-mcp/
