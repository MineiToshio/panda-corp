{
  "$schema": "pandacorp design tokens (CSS custom properties, grouped)",
  "$meta": {
    "name": "Mission Control — Órbita",
    "frozen": null,
    "provenance": "Extracted FROM the owner-approved Órbita prototype (approved 2026-10-21) at docs/design/prototype/index.html by the fidelity split stage; supersedes the Atelier (pixel-RPG) tokens, kept in git history and docs/design/archive/prototype-v1/.",
    "rules": "Green, amber and red mean status or severity only; categories use violet, blue, teal, pink, slate and gold. Phase colours count as status. See docs/design/explorations/visual-refresh-2026/proposal.md iteration 28."
  },
  "source": "docs/design/prototype/index.html (:root, [data-theme] theme blocks, overrides; extracted by the fidelity split stage)",
  "fonts": {
    "display": {
      "family": "Space Grotesk",
      "file": "docs/design/prototype/assets/SpaceGrotesk.ttf",
      "axes": {
        "wght": "300-700"
      },
      "weights": [
        500,
        600,
        700
      ],
      "license": "SIL OFL 1.1 (assets/SpaceGrotesk-LICENSE.txt)",
      "use": "headings, card and section titles, big numbers"
    },
    "body": {
      "family": "Inter",
      "files": [
        "docs/design/prototype/assets/inter-400.ttf",
        "inter-500.ttf",
        "inter-600.ttf",
        "inter-700.ttf",
        "inter-800.ttf"
      ],
      "weights": [
        400,
        500,
        600,
        700,
        800
      ],
      "license": "SIL OFL 1.1 (assets/Inter-OFL.txt)",
      "use": "body, labels, uppercase eyebrows"
    },
    "mono": {
      "family": "JetBrains Mono",
      "file": "docs/design/prototype/assets/JetBrainsMono.ttf",
      "axes": {
        "wght": "100-800"
      },
      "license": "SIL OFL 1.1 (assets/JetBrainsMono-LICENSE.txt)",
      "use": "ids, code, commands and file paths only"
    },
    "selfHosted": true
  },
  "light": {
    "typography": {
      "--font-display": "\"Space Grotesk\", \"Inter\", system-ui, sans-serif",
      "--font-body": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "--font-mono": "\"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
      "--fs-xs": "12px",
      "--fs-sm": "13px",
      "--fs-md": "14px",
      "--fs-base": "15px",
      "--fs-lg": "16px",
      "--fs-xl": "17px",
      "--fs-h3": "19px",
      "--fs-h2": "21px",
      "--fs-h1s": "25px",
      "--fs-h1m": "28px",
      "--fs-h1": "32px"
    },
    "space": {
      "--s1": "4px",
      "--s2": "8px",
      "--s3": "12px",
      "--s4": "16px",
      "--s5": "20px",
      "--s6": "24px",
      "--s8": "32px",
      "--s10": "40px",
      "--s12": "48px"
    },
    "radius": {
      "--r-sm": "8px",
      "--r": "12px",
      "--r-lg": "16px",
      "--r-xl": "22px",
      "--r-xs": "6px",
      "--r-md": "10px",
      "--r-2xl": "28px",
      "--r-pill": "999px"
    },
    "motion": {
      "--ease": "cubic-bezier(.2, .8, .2, 1)",
      "--dur": "160ms"
    },
    "layout": {
      "--sidebar": "252px",
      "--rail-c": "64px",
      "--rail": "76px",
      "--content": "1180px"
    },
    "scene": {
      "--scene-text": "#eef0f6",
      "--scene-text-2": "#b6bccb",
      "--scene-text-3": "#8d94a7",
      "--scene-surface": "#151920",
      "--scene-surface-2": "#1b2029",
      "--scene-line": "#252b37",
      "--scene-line-strong": "#343c4c",
      "--scene-blue": "#8cb4ff",
      "--scene-teal": "#5fd6c6",
      "--scene-violet": "#b9a2ff",
      "--scene-pink": "#f59bc9",
      "--scene-amber": "#f2c46d",
      "--scene-green": "#72da9e",
      "--scene-coral": "#ff9580",
      "--scene-slate": "#a6aec0",
      "--scene-gold": "#f5cc5c"
    },
    "stroke": {
      "--hairline": "1px",
      "--rule": "3px"
    },
    "map": {
      "--map-bg": "#0d1117",
      "--map-room": "#161b22",
      "--map-edge": "#2a3140",
      "--map-label-bg": "#0d1117e0",
      "--map-label-fg": "#eef0f6",
      "--map-handoff-bg": "#eef0f6",
      "--map-handoff-fg": "#161922"
    },
    "color": {
      "--bg": "#f3f4f7",
      "--bg-2": "#eceef3",
      "--surface": "#ffffff",
      "--surface-2": "#f6f7fa",
      "--surface-3": "#eceff4",
      "--line": "#e2e5ec",
      "--line-strong": "#cfd4de",
      "--text": "#161922",
      "--text-2": "#464d5f",
      "--text-3": "#636b7e",
      "--primary-bg": "#161922",
      "--primary-fg": "#ffffff",
      "--focus": "#2f5fd0",
      "--backdrop": "#16192266"
    },
    "elevation": {
      "--shadow": "0 1px 2px #1619220d, 0 10px 28px #1619220f",
      "--shadow-sm": "0 1px 2px #1619221f",
      "--shadow-node": "0 6px 18px #1619221a",
      "--shadow-drop": "0 6px 10px #16192233",
      "--shadow-panel": "20px 0 60px #16192240",
      "--shadow-dialog": "0 30px 80px #16192240",
      "--shadow-toast": "0 16px 40px #16192240"
    },
    "hue": {
      "--blue": "#2350b5",
      "--teal": "#0a675d",
      "--violet": "#5939bd",
      "--pink": "#9c275e",
      "--amber": "#7a4d04",
      "--green": "#17663a",
      "--coral": "#a03722",
      "--slate": "#4b5467",
      "--gold": "#765300"
    },
    "tint": {
      "--tint": "9%",
      "--tint-strong": "16%"
    }
  },
  "dark": {
    "color": {
      "--bg": "#0c0e13",
      "--bg-2": "#101319",
      "--surface": "#151920",
      "--surface-2": "#1b2029",
      "--surface-3": "#232935",
      "--line": "#252b37",
      "--line-strong": "#343c4c",
      "--text": "#eef0f6",
      "--text-2": "#b6bccb",
      "--text-3": "#8d94a7",
      "--primary-bg": "#eef0f6",
      "--primary-fg": "#0c0e13",
      "--focus": "#8fb3ff",
      "--backdrop": "#05070bcc"
    },
    "elevation": {
      "--shadow": "0 1px 0 #ffffff08 inset, 0 12px 32px #00000040",
      "--shadow-sm": "0 1px 2px #00000033",
      "--shadow-node": "0 6px 18px #0000002a",
      "--shadow-drop": "0 6px 10px #00000066",
      "--shadow-panel": "20px 0 60px #00000070",
      "--shadow-dialog": "0 30px 80px #00000070",
      "--shadow-toast": "0 16px 40px #00000066"
    },
    "hue": {
      "--blue": "#8cb4ff",
      "--teal": "#5fd6c6",
      "--violet": "#b9a2ff",
      "--pink": "#f59bc9",
      "--amber": "#f2c46d",
      "--green": "#72da9e",
      "--coral": "#ff9580",
      "--slate": "#a6aec0",
      "--gold": "#f5cc5c"
    },
    "tint": {
      "--tint": "13%",
      "--tint-strong": "22%"
    }
  },
  "overrides": {
    "note": "Token values redefined under a breakpoint, a mode or a component scope; everything else inherits the theme sets above.",
    "rules": [
      {
        "selector": "[data-tone=\"blue\"]",
        "context": "",
        "tokens": {
          "--tone": "var(--blue)"
        }
      },
      {
        "selector": "[data-tone=\"teal\"]",
        "context": "",
        "tokens": {
          "--tone": "var(--teal)"
        }
      },
      {
        "selector": "[data-tone=\"violet\"]",
        "context": "",
        "tokens": {
          "--tone": "var(--violet)"
        }
      },
      {
        "selector": "[data-tone=\"pink\"]",
        "context": "",
        "tokens": {
          "--tone": "var(--pink)"
        }
      },
      {
        "selector": "[data-tone=\"amber\"]",
        "context": "",
        "tokens": {
          "--tone": "var(--amber)"
        }
      },
      {
        "selector": "[data-tone=\"green\"]",
        "context": "",
        "tokens": {
          "--tone": "var(--green)"
        }
      },
      {
        "selector": "[data-tone=\"coral\"]",
        "context": "",
        "tokens": {
          "--tone": "var(--coral)"
        }
      },
      {
        "selector": "[data-tone=\"slate\"]",
        "context": "",
        "tokens": {
          "--tone": "var(--slate)"
        }
      },
      {
        "selector": "[data-tone=\"gold\"]",
        "context": "",
        "tokens": {
          "--tone": "var(--gold)"
        }
      },
      {
        "selector": ".ring",
        "context": "",
        "tokens": {
          "--p": "0",
          "--size": "52px",
          "--w": "6px"
        }
      },
      {
        "selector": ".ring.lg",
        "context": "",
        "tokens": {
          "--size": "76px",
          "--w": "8px"
        }
      },
      {
        "selector": ".stamp .dot",
        "context": "",
        "tokens": {
          "--tone": "var(--teal)"
        }
      },
      {
        "selector": ".manual-live",
        "context": "",
        "tokens": {
          "--color-text": "var(--text)",
          "--color-text2": "var(--text-2)",
          "--color-text3": "var(--text-3)",
          "--color-base": "var(--bg)",
          "--color-surface": "var(--surface)",
          "--color-surface2": "var(--surface-2)",
          "--color-panel": "var(--surface)",
          "--color-card": "var(--surface-2)",
          "--color-card2": "var(--surface-3)",
          "--color-border": "var(--line)",
          "--color-border-strong": "var(--line-strong)",
          "--color-accent": "var(--violet)",
          "--color-accent-bg": "color-mix(in srgb, var(--violet) var(--tint-strong), transparent)",
          "--color-accent-text": "var(--violet)",
          "--color-on-accent": "var(--primary-fg)",
          "--color-secondary": "var(--blue)",
          "--color-info": "var(--blue)",
          "--color-info-bg": "color-mix(in srgb, var(--blue) var(--tint), transparent)",
          "--color-ok": "var(--green)",
          "--color-ok-bg": "color-mix(in srgb, var(--green) var(--tint), transparent)",
          "--color-warn": "var(--amber)",
          "--color-warn-bg": "color-mix(in srgb, var(--amber) var(--tint), transparent)",
          "--color-danger": "var(--coral)",
          "--color-danger-bg": "color-mix(in srgb, var(--coral) var(--tint), transparent)",
          "--color-cat-1": "var(--blue)",
          "--color-cat-2": "var(--teal)",
          "--color-cat-3": "var(--violet)",
          "--color-cat-6": "var(--pink)",
          "--color-cat-7": "var(--amber)",
          "--color-cat-8": "var(--green)",
          "--font-body": "var(--font-body)",
          "--font-sans": "var(--font-body)",
          "--font-display": "var(--font-display)",
          "--font-pixel": "var(--font-display)",
          "--hairline": "1px",
          "--radius": "10px",
          "--radius-sm": "8px",
          "--radius-md": "12px",
          "--radius-lg": "16px",
          "--shadow-1": "none",
          "--avatar-size-sm": "28px"
        }
      },
      {
        "selector": ".hero-stats .ring.lg",
        "context": "@media (max-width: 759px)",
        "tokens": {
          "--size": "60px",
          "--w": "7px"
        }
      },
      {
        "selector": ".page",
        "context": "",
        "tokens": {
          "--gutter": "var(--s10)"
        }
      },
      {
        "selector": ".page",
        "context": "@media (max-width: 1179px)",
        "tokens": {
          "--gutter": "var(--s6)"
        }
      },
      {
        "selector": ".page",
        "context": "@media (max-width: 759px)",
        "tokens": {
          "--gutter": "var(--s4)"
        }
      },
      {
        "selector": ".fragua",
        "context": "",
        "tokens": {
          "--text": "var(--scene-text)",
          "--text-2": "var(--scene-text-2)",
          "--text-3": "var(--scene-text-3)",
          "--surface": "var(--scene-surface)",
          "--surface-2": "var(--scene-surface-2)",
          "--line": "var(--scene-line)",
          "--line-strong": "var(--scene-line-strong)",
          "--blue": "var(--scene-blue)",
          "--teal": "var(--scene-teal)",
          "--violet": "var(--scene-violet)",
          "--pink": "var(--scene-pink)",
          "--amber": "var(--scene-amber)",
          "--green": "var(--scene-green)",
          "--coral": "var(--scene-coral)",
          "--slate": "var(--scene-slate)",
          "--gold": "var(--scene-gold)",
          "--tint": "13%",
          "--tint-strong": "22%"
        }
      },
      {
        "selector": ".card-head :is(h2,h3)>.chip",
        "context": "",
        "tokens": {
          "--tone": "inherit"
        }
      }
    ]
  }
}
