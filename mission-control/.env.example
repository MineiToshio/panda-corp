# Mission Control — environment variables
# Copy to `.env.local` and adjust. Never commit real values (code-conventions: env vars).
# Mission Control is read-only over the factory and never calls Claude, so it needs no secrets.

# --- Factory location -------------------------------------------------------
# Absolute path to the factory repo root (the folder that contains `mission-control/`).
# Optional: by default it resolves to one level up from the process cwd
# (`process.cwd()/..`), which is correct when the app runs from `mission-control/`.
# Set this only when running the app from a different working directory — e.g. tests
# or a non-standard launch. See src/lib/config/config.ts (resolveFactoryRoot).
# PANDACORP_FACTORY_ROOT=/absolute/path/to/panda-corp

# Events NDJSON override. Default is ~/.claude/dashboard-events.ndjson; the e2e suite
# pins it to a frozen fixture via e2e/server-env.json so live builds never move gate
# pixels. See src/lib/events/events.ts (defaultEventsPath).
# PANDACORP_EVENTS_FILE=/absolute/path/to/dashboard-events.ndjson

# Private account registry (read-only). Defaults to ../pandacorp-vault/services/accounts.yaml
# relative to PANDACORP_FACTORY_ROOT. The file contains identities, never secret values.
# PANDACORP_ACCOUNTS_FILE=../pandacorp-vault/services/accounts.yaml

# --- Additional read sources -----------------------------------------------
# Codex event stream; defaults to ~/.codex/dashboard-events.ndjson (a missing transport is skipped).
# PANDACORP_CODEX_EVENTS_FILE=/absolute/path/to/codex/dashboard-events.ndjson
# Codex plugin cache root; obtain it from your local Codex installation.
# PANDACORP_CODEX_PLUGIN_ROOT=/absolute/path/to/codex/plugins/cache

# --- Oracle diagnostics (never set in production) ---------------------------
# Frozen ISO-8601 instant; use the approved prototype clock for reproducible ages.
# MC_CLOCK=2026-10-21T00:20:00.000Z
# Read-only git answers; generated by node docs/design/prototype/scripts/make-fixtures.mjs.
# MC_GIT_FIXTURE=/absolute/path/to/fixtures/git-state.json
