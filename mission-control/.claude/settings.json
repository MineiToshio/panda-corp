{
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh repo delete:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)"
    ],
    "allow": [
      "Bash(bash .pandacorp/session-cleanup.sh create:*)",
      "Bash(bash .pandacorp/session-cleanup.sh register:*)",
      "Bash(bash .pandacorp/session-cleanup.sh finish:*)"
    ]
  }
}
