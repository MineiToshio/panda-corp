{
  "prototype": "docs/design/prototype/app.html",
  "lang": "en",
  "widths": [375, 768, 1280],
  "themes": ["light", "dark"],
  "params": { "demoOff": "demo=off", "host": "host=page", "theme": "theme" },
  "hostAutoClass": "host-auto",
  "workers": 4,
  "probe": { "demoOff": "document.documentElement.dataset.demo === 'off'" },
  "screens": ["library", "detail", "settings"],
  "css": {
    "families": [
      { "name": "fonts", "description": "Self-hosted @font-face rules" },
      { "name": "tokens", "description": "Design tokens: :root custom properties and the dark theme" },
      { "name": "base", "description": "Reset and base typography" },
      { "name": "demo-only", "description": "Prototype-only scaffolding", "note": "DO NOT BUILD: kept only so the reference pages render like the prototype." },
      { "name": "button", "description": "Button", "component": "Button" },
      { "name": "card", "description": "ResumeCard", "component": "ResumeCard" },
      { "name": "dialog", "description": "Dialog", "component": "Dialog" }
    ],
    "rules": [
      { "family": "fonts", "match": "^@font-face$" },
      { "family": "demo-only", "match": "^(\\.demo-|\\[data-demo)" },
      { "family": "base", "match": "^(\\*|body|h[1-6]|a$|:focus-visible)" },
      { "family": "button", "match": "^\\.btn" },
      { "family": "card", "match": "^\\.card" },
      { "family": "dialog", "match": "^(\\.dlg|dialog)" }
    ],
    "overrides": { ":root": "tokens", "[data-theme=\"dark\"]": "tokens" },
    "closingComments": [{ "contains": "end PROTOTYPE-ONLY", "family": "demo-only" }]
  },
  "states": {
    "frd-01-library": [
      { "id": "library", "title": "Library", "route": "#library" },
      { "id": "library-empty", "title": "Library: empty", "route": "#library", "actions": [{ "js": "state.items = []; render();" }] },
      { "id": "library-sort-open", "title": "Library: sort menu open", "route": "#library", "actions": [{ "click": "#sortBtn" }], "capture": "viewport" }
    ],
    "frd-02-settings": [
      { "id": "settings", "title": "Settings", "route": "#settings" },
      { "id": "settings-signed-out", "title": "Settings: signed out", "route": "?session=out#settings" },
      { "id": "delete-confirm", "title": "Delete account: dialog", "route": "#settings", "actions": [{ "click": "[data-action=account-delete]" }, { "waitFor": "dialog[open]" }], "capture": "viewport" },
      { "id": "delete-wrong-email", "title": "Delete account: wrong email", "route": "#settings", "actions": [{ "click": "[data-action=account-delete]" }, { "fill": ["#delEmail", "nobody@example.com"] }, { "click": "#delGo" }, { "waitFor": "#delErr" }], "settleMs": 600, "capture": "viewport", "widths": [375, 1280] }
    ]
  },
  "shard": {
    "extras": [{ "selector": "dialog[open]", "label": "Dialog (top layer in the app)", "style": "position:static;margin:24px auto;transform:none" }],
    "strip": "[data-demo-only]",
    "sectionAttributes": [{ "routeMatch": "session=out", "attribute": "data-session", "value": "out" }]
  },
  "components": [
    { "name": "Button (primary)", "route": "#library", "root": ".btn-primary", "children": [".ic"], "states": {
      "default": {},
      "hover": { "force": [["$", ["hover"]]] },
      "focus-visible": { "force": [["$", ["focus", "focus-visible"]]] },
      "disabled": { "attr": [["$", "disabled", ""]] }
    } },
    { "name": "ResumeCard", "route": "#library", "root": ".card", "children": [".card-title", ".card-meta", ".card-cover img"], "states": {
      "default": {},
      "hover": { "force": [["$", ["hover"]]] },
      "selected": { "cls": [["$", "is-selected", true]] }
    } },
    { "name": "Sort menu", "route": "#library", "root": ".sort", "children": [".sort-btn", ".sort-pop"], "states": {
      "closed": {},
      "open": { "click": "#sortBtn" }
    } }
  ],
  "floating": [{ "component": "Sort menu", "state": "open", "panel": "$ .sort-pop", "anchor": "$ .sort-btn" }],
  "scope": { "mode": "pareto" },
  "catalog": { "title": "App components", "sheetMax": 30000 },
  "identity": { "screens": ["library", "settings"], "widths": [375, 1280], "theme": "light", "attempts": 3 },
  "tokens": { "groups": [{ "group": "imageViewer", "match": "^--iv-" }] },
  "preflight": { "minFontPx": 12, "maxLiteralColors": 0, "maxLiteralLengths": 150, "smallTextIgnore": [".poster-legal"] },
  "exports": "Object.fromEntries([...document.querySelectorAll('svg symbol[id]')].map((s) => ['icons/' + s.id + '.svg', '<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"' + s.getAttribute('viewBox') + '\">' + s.innerHTML + '</svg>']))"
}
