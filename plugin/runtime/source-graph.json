{
  "facts": {
    "plugin_identity": {
      "source": "plugin/runtime/plugin-metadata.json",
      "outputs": [
        "plugin/.claude-plugin/plugin.json",
        "plugin/.codex-plugin/plugin.json"
      ],
      "generator": "plugin/scripts/generate-plugin-manifests.mjs",
      "contract": "Runtime-compatible fields are projected independently; Codex plugin.json never registers hooks."
    },
    "repo_local_codex_marketplace": {
      "source": "plugin/runtime/plugin-metadata.json",
      "outputs": [
        ".agents/plugins/marketplace.json",
        "plugins/pandacorp"
      ],
      "contract": "The catalog exposes one local Pandacorp entry; Codex resolves ./plugins/pandacorp from the repository root, whose relative symlink points to canonical plugin/ and never copies plugin content."
    },
    "model_tiers": {
      "source": "plugin/runtime/model-tiers.json",
      "consumers": [
        "plugin/scripts/generate-codex-agents.mjs",
        "plugin/runtime/build/routing.mjs",
        "plugin/runtime/build/quota.mjs"
      ]
    },
    "shared_agents": {
      "source_glob": "plugin/agents/*.md",
      "outputs": [
        ".codex/agents/analytics.toml",
        ".codex/agents/architect.toml",
        ".codex/agents/backend-dev.toml",
        ".codex/agents/copywriter.toml",
        ".codex/agents/designer.toml",
        ".codex/agents/devops.toml",
        ".codex/agents/frontend-dev.toml",
        ".codex/agents/implementer.toml",
        ".codex/agents/librarian.toml",
        ".codex/agents/product-manager.toml",
        ".codex/agents/researcher.toml",
        ".codex/agents/reviewer.toml",
        ".codex/agents/security-auditor.toml",
        ".codex/agents/test-writer.toml"
      ]
    },
    "codex_tier_workers": {
      "source": "plugin/runtime/codex-tier-workers.json",
      "outputs": [
        ".codex/agents/tier-mech.toml",
        ".codex/agents/tier-standard.toml",
        ".codex/agents/tier-judge.toml"
      ]
    },
    "skill_capabilities": {
      "source": "plugin/runtime/skill-runtime-policy.json",
      "outputs": [
        "plugin/runtime/skill-capabilities.json"
      ]
    },
    "codex_enforcement": {
      "source": "plugin/runtime/enforcement-policy.json",
      "consumers": [
        "plugin/scripts/pandacorp-hook-adapter.mjs"
      ],
      "registration_owner": ".codex/config.toml plus plugin/hooks/codex-hooks.json (outside plugin.json)",
      "outputs": [
        ".codex/config.toml",
        ".codex/rules/pandacorp.rules",
        "plugin/hooks/codex-hooks.json",
        "plugin/templates/shared/.codex/config.toml",
        "plugin/templates/shared/.codex/rules/pandacorp.rules"
      ]
    },
    "neutral_build_state": {
      "source": "plugin/runtime/build-state.mjs",
      "consumers": [
        "plugin/scripts/pandacorp-build-state.mjs"
      ]
    },
    "product_change_queue_transactions": {
      "source": "plugin/runtime/build-state.mjs",
      "consumers": [
        "plugin/scripts/test-build-state.mjs"
      ]
    },
    "event_vocabulary": {
      "source": "plugin/runtime/event-vocabulary.json",
      "outputs": [
        "mission-control/src/lib/events/event-vocabulary.json"
      ],
      "consumers": [
        "plugin/runtime/event-transport.mjs",
        "mission-control/src/lib/events/event-contract.ts"
      ]
    },
    "runtime_event_transport": {
      "source": "plugin/runtime/event-transport.mjs",
      "consumers": [
        "plugin/runtime/build/telemetry.mjs"
      ]
    },
    "build_engine_v2": {
      "contract_docs": [
        "plugin/docs/build-engine-cli.md",
        "factory/standards/build-engine.md"
      ],
      "schemas": "plugin/runtime/build/schemas/",
      "consumers": [
        "plugin/scripts/pandacorp-build.mjs",
        "plugin/runtime/build/lifecycle.mjs",
        "plugin/runtime/build/next.mjs",
        "plugin/runtime/build/planner.mjs",
        "plugin/runtime/build/routing.mjs",
        "plugin/runtime/build/quota.mjs",
        "plugin/runtime/build/admission.mjs",
        "plugin/runtime/build/drive.mjs",
        "plugin/runtime/build/state.mjs",
        "plugin/runtime/build-state.mjs",
        "plugin/runtime/build/next/",
        "plugin/runtime/build/failure/",
        "plugin/runtime/build/lifecycle/",
        "plugin/runtime/build/planner/",
        "plugin/runtime/build/review/",
        "plugin/runtime/build/doubts/",
        "plugin/runtime/build/answers/",
        "plugin/runtime/build/drive/",
        "plugin/runtime/build/admission/",
        "plugin/runtime/build/integrate/",
        "plugin/runtime/build/land/",
        "plugin/runtime/build/units/",
        "plugin/runtime/build/preflight/",
        "plugin/runtime/build/card/"
      ],
      "contract": "The default build engine is the runtime-neutral v2 CLI. The CLI reference and schemas define its interface; factory/standards/build-engine.md owns policy and model-tiers.json owns routing. Modules use injected dependencies and import no retired engine files.",
      "source": "plugin/runtime/build/lifecycle.mjs"
    },
    "whole_frd_gate_oracle": {
      "source": "plugin/agents/reviewer.md",
      "consumers": [
        "plugin/runtime/build/units/render.mjs",
        "plugin/scripts/generate-codex-agents.mjs"
      ],
      "contract": "The reviewer agent is the canonical gate policy, read into v2 unit briefs and projected into the generated reviewer TOML."
    },
    "durable_gamification_accounting": {
      "source": "mission-control/src/lib/gamification/ledger.ts",
      "outputs": [
        "factory/gamification-ledger.json"
      ],
      "consumers": [
        "mission-control/src/lib/gamification/guildState.ts",
        "mission-control/src/lib/achievements/readerData.ts",
        "mission-control/src/app/configuration/page.tsx"
      ],
      "single_writer": "mission-control/src/app/_actions/snapshotLedger.ts"
    }
  }
}
